# cgroup.conf — generated by Ansible; do not edit manually.

CgroupPlugin={{ slurm_cgroup_plugin }}

# Constrain jobs to their allocated cores and RAM.
ConstrainCores=yes
ConstrainRAMSpace=yes

# ConstrainDevices=yes is essential: it fences each job to its allocated
# GPU devices (/dev/nvidia*) via the cgroup devices controller.
ConstrainDevices=yes

ConstrainSwapSpace=no
