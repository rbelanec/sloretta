# gres.conf — generated by Ansible; do not edit manually.
#
# Devices are mapped explicitly (/dev/nvidiaN) rather than via NVML autodetect
# because Ubuntu's slurm-wlm package is not built against libnvidia-ml.
# If you switch to a Slurm build that includes libnvidia-ml support, replace
# the NodeName lines below with the single line:
#   AutoDetect=nvml

{% for node in groups['compute'] %}
{% for i in range(hostvars[node].slurm_gpu_count | int) %}
NodeName={{ node }} Name=gpu Type={{ hostvars[node].slurm_gpu_type }} File=/dev/nvidia{{ i }}
{% endfor %}
{% endfor %}
