# slurm.conf — generated by Ansible; do not edit manually.
# Regenerated on every run; changes belong in inventory or group_vars.

# ── Controller ──────────────────────────────────────────────────────────────
ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ groups['login'][0] }}

# ── Paths & logging ─────────────────────────────────────────────────────────
SlurmctldPidFile=/run/slurm/slurmctld.pid
SlurmctldPort=6817
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdPidFile=/run/slurm/slurmd.pid
SlurmdPort=6818
SlurmdLogFile=/var/log/slurm/slurmd.log
SlurmdSpoolDir=/var/spool/slurmd
SlurmUser=slurm
StateSaveLocation=/var/spool/slurmctld

# ── Auth & crypto ────────────────────────────────────────────────────────────
AuthType=auth/munge
CryptoType=crypto/munge

# ── Process tracking & task ──────────────────────────────────────────────────
ProctrackType=proctrack/cgroup
TaskPlugin=task/affinity,task/cgroup

# ── Return-to-service ────────────────────────────────────────────────────────
# 1 = automatically return a node to service when slurmd reconnects after a failure.
ReturnToService=1

# ── Scheduling ──────────────────────────────────────────────────────────────
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory

# ── GRES (GPUs) ──────────────────────────────────────────────────────────────
GresTypes=gpu

# ── Accounting ──────────────────────────────────────────────────────────────
{% if slurm_accounting %}
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ groups['login'][0] }}
AccountingStoragePort=6819
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency=30
{% else %}
AccountingStorageType=accounting_storage/none
JobAcctGatherType=jobacct_gather/none
{% endif %}

# ── Compute nodes ────────────────────────────────────────────────────────────
# Generated by iterating groups['compute'] and reading hostvars.
# CPUs  defaults to ansible_processor_vcpus (all logical CPUs).
# RealMemory defaults to 95 % of ansible_memtotal_mb to leave headroom for OS.
# Both can be overridden per-host with slurm_node_cpus / slurm_node_memory.
{% for node in groups['compute'] %}
{% set cpus = hostvars[node].slurm_node_cpus | default(hostvars[node].ansible_facts['processor_vcpus'] | default(1)) | int %}
{% set mem_total = hostvars[node].ansible_facts['memtotal_mb'] | default(0) | int %}
{% set mem = hostvars[node].slurm_node_memory | default((mem_total * 0.95) | round | int) | int %}
NodeName={{ node }} CPUs={{ cpus }} RealMemory={{ mem }} Gres=gpu:{{ hostvars[node].slurm_gpu_type }}:{{ hostvars[node].slurm_gpu_count }} State=UNKNOWN
{% endfor %}

# ── Partition ────────────────────────────────────────────────────────────────
PartitionName={{ slurm_partition_name }} Nodes={{ groups['compute'] | join(',') }} Default=YES MaxTime=INFINITE State=UP
