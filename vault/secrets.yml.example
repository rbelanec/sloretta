---
# Copy this file to vault/secrets.yml and encrypt it:
#   ansible-vault encrypt vault/secrets.yml
#
# Reference in site.yml via vars_files: [vault/secrets.yml]
# Run playbook with: ansible-playbook site.yml --ask-vault-pass
#                or: ansible-playbook site.yml --vault-password-file .vault_pass

slurm_db_password: "change_me_to_a_strong_password"
